# Supabase Public Credentials (Frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Admin Credential (Server-side Ingestion only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gateway Secret Key (ตรงกับ GATEWAY_SECRET_KEY ในเครื่อง Raspberry Pi 5)
GATEWAY_SECRET_KEY=smart_farm_secret_token_12345

# Email Alert Service (Resend)
RESEND_API_KEY=re_123456789
ALERT_EMAIL_RECIPIENT=farmer@example.com
